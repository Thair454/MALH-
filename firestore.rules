rules_version = '2';

// Reglas de Firestore · Malhú (proyecto malhudemo)
// - Cualquiera puede LEER el menú y los ingredientes (la web pública los muestra).
// - Cualquiera puede CREAR un pedido (la pantalla de confirmación), pero no leerlo ni cambiarlo.
// - Solo el propietario (sesión de Firebase Authentication con su correo) puede
//   editar platos e ingredientes, y ver o actualizar los pedidos.
// Para cambiar o agregar propietarios, edita la lista de correos de esPropietario()
// y vuelve a publicar las reglas:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function esPropietario() {
      return request.auth != null
        && request.auth.token.email in ['acevedojean454@gmail.com'];
    }

    // Menú: platos del día, del menú, exclusivos e ingredientes ("Ingredientes " lleva un espacio al final)
    match /{coleccion}/{id} {
      allow read: if coleccion in ['platos_del_dia', 'Plato fijos', 'platos_exclusivos', 'Ingredientes ', 'Ingredientes'];
      allow write: if esPropietario()
        && coleccion in ['platos_del_dia', 'Plato fijos', 'platos_exclusivos', 'Ingredientes ', 'Ingredientes'];
    }

    // Pedidos
    match /Pedidos/{id} {
      allow create: if request.resource.data.keys().hasAll(['numero', 'items', 'cliente', 'totales'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50;
      allow read, update, delete: if esPropietario();
    }
  }
}
